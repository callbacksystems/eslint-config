{
  "name": "@callbacksystems/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint configuration for Callback Systems projects.",
  "license": "MIT",
  "author": "Callback Systems",
  "contributors": [
    "Bruno Prieto <brunoprietog@hey.com>"
  ],
  "homepage": "https://github.com/callbacksystems/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callbacksystems/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/callbacksystems/eslint-config/issues"
  },
  "keywords": [
    "callbacksystems",
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "rails",
    "hotwire",
    "stimulus",
    "turbo",
    "importmap",
    "react",
    "react-native",
    "svelte",
    "astro"
  ],
  "type": "module",
  "exports": {
    "./base": "./src/base.js",
    "./browser": "./src/browser.js",
    "./edge": "./src/edge.js",
    "./node": "./src/node.js",
    "./astro": "./src/astro.js",
    "./rails": "./src/rails.js",
    "./react": "./src/react.js",
    "./react-native": "./src/react-native.js",
    "./restrictions": "./src/restrictions.js",
    "./rules": "./src/rules/index.js",
    "./stimulus": "./src/stimulus.js",
    "./svelte": "./src/svelte.js",
    "./turbo": "./src/turbo.js"
  },
  "imports": {
    "#rules": "./src/rules/index.js",
    "#internal/*": "./src/internal/*.js",
    "#test/*": "./test/*.js",
    "#*": "./src/*.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "lint": "eslint --cache src/ test/",
    "test": "node --test 'test/**/*.test.js'",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 node --test 'test/configs/snapshots.test.js'",
    "release": "npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-expo": "^1.0.3",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "minimatch": "^10.2.5",
    "svelte-eslint-parser": "^1.6.1"
  },
  "devDependencies": {
    "astro": "^6.2.2",
    "eslint": "^10.4.1",
    "svelte": "^5.55.5"
  }
}
